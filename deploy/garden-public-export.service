[Unit]
Description=Export a privacy-safe garden observatory snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/garden-observatory-public
EnvironmentFile=/home/pi/.config/garden-observatory-public.env
ExecStart=/usr/bin/bash /home/pi/garden-observatory-public/scripts/publish_snapshot.sh
